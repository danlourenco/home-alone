  yaw: 180
  rot0: {x: -0, y: 1, z: -0, w: -0.00000004371139}
  src: '{"name":"breakfast_chair_n2","prefab":"Assets/Classic Wooden Furniture Pack/Prefabs/CHAIR_01.prefab","x":[0.733,1.268],"z":[4.18,4.689],"y0":0.0,"height":1.0,"back":"","yaw":180,"collide":true,"hides":[],"source":"props lane (props.py add, Oct 19): film IMG_4306 (user photo of a film still) + production still ''Breakfast Room'': tall pine vase-back chairs with red patterned seats round the oval table; Classic Wooden Furniture Pack CHAIR_01 (0.52 x 0.49 x 0.97) at 1.0 m, pushed in to the north edge (back 0.07 m outside it, as the film chairs stand); row set 0.15 m west of the table centre so the bandit (0.59 m) passes between the east chair and the wall corner/corner chest (walk note Oct 19 08:42). Model 0.516 x 0.491 x 0.965 m (CHAIR_01), fitted to 0.535 x 0.509 x 1.0. Tinted from the pack''s dark stain toward the film''s honey pine (x2.6/2.3/1.6, by eye against the film still). Deviation: the pack chair is a ladder back with a wooden seat; the film''s are vase-back with red patterned seat pads.","tint":[2.6,2.3,1.6]}'
  c0: {x: 1.0005, y: -2.526, z: -4.4344997}
