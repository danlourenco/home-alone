  yaw: 0
  rot0: {x: -0, y: -0, z: -0, w: 1}
  src: '{"name":"breakfast_chair_s2","prefab":"Assets/Classic Wooden Furniture Pack/Prefabs/CHAIR_01.prefab","x":[0.733,1.268],"z":[5.071,5.58],"y0":0.0,"height":1.0,"back":"","yaw":0,"collide":true,"hides":[],"source":"props lane (props.py add, Oct 19): film IMG_4306 (user photo of a film still) + production still ''Breakfast Room'': tall pine vase-back chairs with red patterned seats; Classic Wooden Furniture Pack CHAIR_01 at 1.0 m, pushed in to the south edge, in line with the north row. Model 0.516 x 0.491 x 0.965 m (CHAIR_01), fitted to 0.535 x 0.509 x 1.0. Tinted from the pack''s dark stain toward the film''s honey pine (x2.6/2.3/1.6, by eye against the film still). Deviation: the pack chair is a ladder back with a wooden seat; the film''s are vase-back with red patterned seat pads.","tint":[2.6,2.3,1.6]}'
  c0: {x: 1.0005, y: -2.526, z: -5.3255}
