  src: '{"name":"kevin_bookcase","prefab":"Assets/Classic Wooden Furniture Pack/Prefabs/WALL_SHELF_01.prefab","x":[11.34,11.66],"z":[5.2,6.0],"y0":0.0,"height":1.0,"back":"+x","collide":true,"source":"props lane (Kevin+Jeff TRIAL 1 Oct 18, changes/2026-10-18-kevin-room.json; spec/dressing/kevin.json): Marina 355 s: a low open pine bookcase with toys between the two front windows, cork board above; film 303: open pine shelves with toys. Yaw 90 = back on +x (parents_etagere''s back -z at 0, turned). Oct 18 dressing round: the open etagere (SHELVES_01) swapped for the same pack''s solid-sided WALL_SHELF_01 (1.32 x 0.38 x 1.08, fitted to 0.80 x 0.32 x 1.00), tinted honey pine like the dresser (Marina 355: solid pine sides).","floor":"upper","hides":[],"tint":[1.9,1.55,1.05],"yaw":270}'
  c0: {x: 11.5, y: 0.5, z: -5.6}
