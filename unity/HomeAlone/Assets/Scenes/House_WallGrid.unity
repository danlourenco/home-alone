  spec: store_props
  yaw: 270
  rot0: {x: -0, y: 0.7071068, z: -0, w: -0.7071068}
  src: '{"name":"grandfather_clock","prefab":"Assets/Fadnn - Vintage Interior Furniture Pack/Props/Prefabs/HDRP/SM_PendulumClock_01.prefab","x":[9.76,10.09],"z":[5.446,5.998],"y0":0.0,"height":2.069,"hides":[],"collide":true,"source":"Marina 1124-1130 s: a grandfather clock on the dining room''s front wall, centred on the pier between the two French windows (1128 s: clock centre 298 px vs pier centre 295 px of a 100 px pier = +4 cm, within the read). Pier z 5.117-6.327 (spec/house_spec.ground.json front_french_* spans); back 4 cm off the wall face x 10.13 (wainscot cap 3 cm proud + 1 cm). Model at native size 0.552 x 0.330 x 2.069 m (Marina''s reads ~2.0 m). yaw pinned 270 (Oct 18): the area-scored auto turn (StoreProps.Orient) put its plain back panel to the room.","back":"+x","yaw":270}'
  c0: {x: 9.925, y: -1.9914999, z: -5.722}
