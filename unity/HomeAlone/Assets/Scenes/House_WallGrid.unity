  yaw: 180
  rot0: {x: -0, y: 1, z: -0, w: -0.00000004371139}
  src: '{"name":"kitchen_corner_chest","prefab":"Assets/Classic Wooden Furniture Pack/Prefabs/DRAWER_CAB_01.prefab","x":[2.67,3.37],"z":[3.66,4.051],"y0":0.0,"height":0.699,"back":"-z","collide":true,"hides":[],"source":"props lane (props.py add, Oct 18): film 10508-10512: a low warm-wood chest against the kitchen wall left of the dining swing door (by the corner), a green glass pitcher on a tray on it, two framed fruit prints above (walk note Oct 18 21:20); size: the pack model''s real size (one ruler: none needed). Model 1.136 x 0.391 x 0.699 m (DRAWER_CAB_01), native size. Width fitted to 0.90 m (Oct 18): the bandit must stand 0.5 m inside the corner door (room walk test), as the film''s gap between the chest and the door (10512). | Oct 19 (walk note 08:42 ''can''t walk between the breakfast table and the hutch''): 0.90 -> 0.70 m wide (x0.62 of the model), its right end kept 0.75 m off the dining door wall (the door''s swing room); the film shows only the chest''s right part (10508-10512: the pitcher and the right end up to the door casing), so the width is authored, not measured. With the table''s stepped-end colliders (kitchen.json) the gap to the table is 0.64 m (bandit 0.59, kid 0.44).","yaw":180}'
  c0: {x: 3.02, y: -2.6765, z: -3.8555002}
