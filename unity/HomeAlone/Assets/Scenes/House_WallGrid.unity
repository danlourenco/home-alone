  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PlacedProp
  spec: store_props
  yaw: 90
  rot0: {x: -0, y: 0.7071068, z: -0, w: 0.7071068}
  src: '{"name":"breakfast_chair_w","prefab":"Assets/Classic Wooden Furniture Pack/Prefabs/CHAIR_01.prefab","x":[-0.299,0.21],"z":[4.612,5.147],"y0":0.0,"height":1.0,"back":"","yaw":90,"collide":true,"hides":[],"source":"props lane (props.py add, Oct 19): film IMG_4306 / production still ''Breakfast Room'': a chair at the table''s end; Classic Wooden Furniture Pack CHAIR_01 at 1.0 m. No chair at the east end: it would close the walk past the corner chest (walk note Oct 19 08:42). Model 0.516 x 0.491 x 0.965 m (CHAIR_01), fitted to 0.535 x 0.509 x 1.0. Tinted from the pack''s dark stain toward the film''s honey pine (x2.6/2.3/1.6, by eye against the film still). Deviation: the pack chair is a ladder back with a wooden seat; the film''s are vase-back with red patterned seat pads.","tint":[2.6,2.3,1.6]}'
  c0: {x: -0.044499993, y: -2.526, z: -4.8795}
