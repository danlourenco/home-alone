  rot0: {x: -0, y: 0.7071068, z: -0, w: -0.7071068}
  src: '{"name":"hall_table_parents","floor":"upper","prefab":"Assets/Classic Wooden Furniture Pack/Prefabs/SIDE_TABLE_01.prefab","x":[6.591,6.891],"z":[5.53,6.43],"y0":0.0,"height":0.762,"back":"+x","source":"Upstairs hall (Oct 16, TRIAL, changes/2026-10-16-upstairs-hall.json; furniture-plan H2): owned SIDE_TABLE_01 as the film''s dark hall table (film 10819/2687/10741/410: on the vestibule''s right wall seen from the stair, its far end at the parents'' end wall). Box from spec/dressing/hall.json consoles: top 0.762 (film 10819: on the horizon with the cap rail, camera height 0.759 on the door ruler), 0.90 x 0.30, back 3 cm off the wall (the cap rail is 3 cm proud at the table''s height). The model (0.945 x 0.473 x 0.645) is fitted x0.95 / x0.63 / x1.18: slimmer and taller; its cabriole legs differ from the film''s square tapered legs (DEVIATIONS 63).","yaw":270}'
  c0: {x: 6.7409997, y: 0.381, z: -5.98}
