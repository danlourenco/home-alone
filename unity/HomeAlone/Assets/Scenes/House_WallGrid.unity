  yaw: 341
  rot0: {x: -0, y: 0.16504754, z: -0, w: -0.9862856}
  src: '{"name":"living_grand","floor":"ground","prefab":"Assets/Fadnn - Vintage Interior Furniture Pack/Props/Prefabs/HDRP/SM_Piano_01.prefab","x":[7.87,9.37],"z":[13.47,15.15],"y0":0.0,"height":0.747,"yaw":341.0,"back":"","hides":[],"collide":true,"source":"PROP, user Oct 17: the pack grand (with its stool) stands in for the film''s console upright (DEVIATIONS 58). Marina''s grand sits before the front wall''s den-side window: long side along the front wall, keyboard and stool toward the foyer side (the film''s keyboard side), tail toward the den wall. Box: the pack''s concert grand (2.72 m case, 3.31 m with the stool) shortened front to back to x0.6, a 1.63 m baby grand at full keyboard width (user Oct 17: \"that piano is too big ... resize\"), placed by eye; the user adjusts with Home Alone > Save Prop Placement | user Oct 17: \"make the piano a little bit smaller? like 75% of the size now\" (uniform x0.75 about its centre)","placed_by":"user","scale":[0.75,0.75,0.45]}'
  c0: {x: 8.62, y: -2.6525183, z: -14.309999}
