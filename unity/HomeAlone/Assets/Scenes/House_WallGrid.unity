  spec: store_props
  yaw: 180
  rot0: {x: -0, y: 1, z: -0, w: -0.00000004371139}
  src: '{"name":"dining_chair_sunroom_2","prefab":"Assets/Purchased/Chairs/Chippendale_Dining.glb","x":[6.924,7.466],"z":[4.252,4.76],"y0":0.0,"height":0.995,"yaw":180,"back":"","hides":[],"collide":true,"source":"Dining room (props lane, Oct 20): the user''s CGTrader CHIPPENDALE CHAIR (tools/house/purchased_chairs.py; gitignored) replaces the CHAIR_01 stand-in at the same place and facing: the film''s eight Chippendale chairs (246/252: pierced splat, carved crest, dark mahogany; tapestry slip seats). Model 0.542 x 0.508 x 0.995 at x0.88 of the purchased size (seat 0.458, back 0.995: a standard Chippendale side chair), front edge kept 2.5 cm clear of the cloth''s skirt. Wood film 246 crest #351308, seat film 246 gold-tan tapestry. The film''s chairs have cabriole legs as the model; any armchair at the ends is not shown (film 246 shows one carver against the right wall)."}'
  c0: {x: 7.1949997, y: -2.5285, z: -4.506}
