  spec: store_props
  yaw: 0
  rot0: {x: 0.000000015454312, y: 0.7071068, z: -0.000000015454312, w: 0.7071068}
  src: '{"name":"basement_door","prefab":"Assets/Free Wood Door Pack/Prefab/Wood/Door_3/Door_3_White.prefab","x":[-1.354,-0.375],"z":[6.257,6.317],"y0":0.0,"height":2.1,"back":"+z","hides":["basement_Casing_l","basement_Casing_r","basement_Casing_head"],"collide":false,"source":"user walk note Oct 18 03:14 (foyer rear, shot 20261018-031353): ''these doors should all be replaced with real doors, the same doors used elsewhere inside'' (overnight 12, not walked). Door_3 White over the basement door''s plain slab (house_spec.ground.json stair boxes basement_PropDoor x -1.284..-0.445, 0.84 m: a 33 in leaf, tools/house/reconcile.py). The frame takes the generated casing''s outline (x -1.354..-0.375, to 2.10 m: casing legs 7 cm, head to 2.10) and replaces it (casings and the slab''s knob hidden); the slab itself stays drawn behind the leaf, 0.5 cm off the frame''s back (z 6.322), so the door still reads shut from every side. OPEN 90 deg into the basement landing, hinged at its low-x jamb (Oct 18 basement shell TRIAL, changes/2026-10-18-basement-shell.json: the slab and knob boxes are gone, the landing behind it is one riser down; hinge side ASSUMED: the high-x jamb would put the open leaf across the flight''s head)","open":90,"hinge":"lo"}'
  c0: {x: -0.8644999, y: -1.9760001, z: -6.7105103}
