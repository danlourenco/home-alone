  spec: store_props
  yaw: 90
  rot0: {x: 9.533324e-10, y: 0.99904823, z: -0.000000021834891, w: 0.04361942}
  src: '{"name":"parents_bath_door","floor":"upper","prefab":"Assets/Free Wood Door Pack/Prefab/Wood/Door_3/Door_3_White.prefab","x":[3.215,3.275],"z":[3.5369,4.3911],"y0":0.0,"height":2.087,"back":"-x","hides":["Casing"],"collide":false,"open":85,"hinge":"lo","source":"user walk note Oct 18 03:14 (foyer rear, shot 20261018-031353): ''these doors should all be replaced with real doors, the same doors used elsewhere inside'' (overnight 12, not walked). Door_3 White as the other interior doors (linen, girls_a/b, attic, Buzz, parents; the film''s are white six-panel: DEVIATIONS 63h). The pack frame (outer = leaf x 1.124 wide, x 1.027 tall) centred on the opening, 0.5 cm proud of the face, 6 cm deep. Opening z 3.584-4.344 (0.76 m, stock 30 x 80 in) had no leaf. Frame on the bedroom face (x 3.21), replacing its casing (the bath-side casing stays). Hinge ASSUMED at the lo end (z 3.584; the pack leaf''s own hinge edge as it turns here, yaw 270: hinged at hi its lever stood in the wall, clash gate); swings into the bath, resting toward z 2.82 (the bath runs to z 2.373 there); open 85 deg AUTHORED."}'
  c0: {x: 2.878253, y: 1.0435, z: -3.964}
