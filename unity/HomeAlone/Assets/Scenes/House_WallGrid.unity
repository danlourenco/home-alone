  yaw: 180
  rot0: {x: -0, y: 1, z: -0, w: -0.00000004371139}
  src: '{"name":"foyer_chair_front","prefab":"Assets/Purchased/Chairs/Chippendale_Foyer.glb","x":[6.239,6.781],"z":[7.83,8.338],"y0":0.0,"height":0.995,"yaw":180,"back":"","hides":["ChairWood","ChairSeat"],"collide":false,"source":"Foyer (props lane, Oct 20): the user''s CGTrader CHIPPENDALE CHAIR, foyer variant (red slip seat, HiFi_FoyerSeat), replacing the generated side chair (hifi_foyer_props.py ChairWood/ChairSeat, hidden) flanking the console: film 1616/1690/10673, centres Marina 312 s (spec/dressing/foyer_props.json chairs), back to the dining wall at z 7.83 as the generated chair. Model 0.542 x 0.508 x 0.995. Deviation: the film''s foyer chairs have straight square legs with an H stretcher, a vase splat and a 0.92 back (seat 0.48); this is the dining chair (cabriole legs, pierced splat, back 0.995, seat 0.458; the plan''s one licence for both rooms). The dressing boxes keep the colliders."}'
  c0: {x: 6.51, y: -2.5285, z: -8.084}
