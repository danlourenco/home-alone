#!/bin/sh
# Change gate (skill change-gate): a commit that changes geometry inputs or a built house scene must stage a
# changes/*.json record that passes tools/house/change_gate.py, AND every record already built (user_walk not
# "rejected") must still pass: geometry can't land on top of a change the gate now fails. Pure rebuild outputs:
# commit with --no-verify and say so.
# Generated models (Oct 16): a model must be rebuilt from its current sources; the stamp records what built it
python3 tools/house/build_models.py --check || exit 1
python3 tools/house/openings.py --check || exit 1     # every opening's casing/limits (spec/openings.json) current; a broken limit refuses
python3 tools/house/trim_faces.py --check || exit 1   # the trim face model (spec/trim_faces.json) is current and its runs all terminate
geo=$(git diff --cached --name-only | grep -E '^(measurements/|spec/house_spec|spec/furniture\.json|spec/geometry\.json|spec/trim_faces\.json|spec/openings\.json|tools/house/openings\.py|spec/dressing/|tools/house/reconcile\.py|tools/house/hifi_[^/]*\.py|unity/HomeAlone/Assets/Scenes/(IntactHouseReference|Greybox_Upstairs|House_WallGrid)\.unity)')
[ -z "$geo" ] && exit 0
recs=$(git diff --cached --name-only --diff-filter=AM | grep -E '^changes/.*\.json$')
if [ -z "$recs" ]; then
  echo "change gate: geometry changed ($(echo $geo | tr '\n' ' ')) but no changes/*.json record is staged. See .claude/skills/change-gate/SKILL.md"
  exit 1
fi
built=$(grep -L '"user_walk": "rejected"' changes/*.json)
uv run -q python tools/house/change_gate.py $(echo "$recs $built" | tr ' ' '\n' | sort -u)
gate=$?
# Seam gate (Oct 15): a committed grey-box scene must have no unexplained flicker, ledge or gap in its build report
if echo "$geo" | grep -q 'Greybox_Upstairs\.unity'; then
  uv run -q python -I tools/house/seam_gate.py || exit 1
fi
exit $gate
